{
  "version": "0.2",
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": [
    "vgv_allowed",
    "vgv_forbidden"
  ],
  "dictionaryDefinitions": [
    {
      "name": "vgv_allowed",
      "path": "https://raw.githubusercontent.com/verygoodopensource/very_good_dictionaries/main/allowed.txt",
      "description": "Allowed VGV Spellings"
    },
    {
      "name": "vgv_forbidden",
      "path": "https://raw.githubusercontent.com/verygoodopensource/very_good_dictionaries/main/forbidden.txt",
      "description": "Forbidden VGV Spellings"
    }
  ],
  "useGitignore": true,
  "ignorePaths": [
    "**/*.g.dart",
    "pubspec.lock",
    "packages/earshot_classifier/earshot_classifier_platform_interface/lib/src/vocabulary/apple_labels.dart",
    "packages/earshot_classifier/earshot_classifier_platform_interface/lib/src/vocabulary/earshot_sound.dart",
    "packages/earshot_classifier/earshot_classifier_platform_interface/lib/src/vocabulary/yamnet_labels.dart",
    "tools/vocab/**"
  ],
  "words": [
    "behaviour",
    "Blackman",
    "dartdoc",
    "darwin",
    "didgeridoo",
    "earshot",
    "fluttium",
    "hashcode",
    "Leq",
    "LiteRT",
    "litert",
    "MediaPipe",
    "mediapipe",
    "mocktail",
    "pana",
    "PCM",
    "pcm",
    "podspec",
    "podspecs",
    "polyphase",
    "resampler",
    "Resampler",
    "resampling",
    "rthurmonteiro",
    "sinc",
    "Siri",
    "SoundAnalysis",
    "sublist",
    "SwiftPM",
    "tensorflow",
    "tflite",
    "UNPROCESSED",
    "xcprivacy",
    "YAMNet",
    "yamnet"
  ]
}
